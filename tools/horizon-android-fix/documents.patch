+/// Moves the checked, staged file to `target`, leaving nothing half-written behind.
+///
+/// The staged file lives in the app cache (`Context.getCacheDir()`), and Android may
+/// back that with a different filesystem than the profile's folder, so `rename` fails
+/// with `EXDEV` ("Cross-device link") and used to abort the whole import. Copying
+/// into a scratch file beside the target and renaming that is atomic within one
+/// directory whatever the source filesystem is, and free space is checked first so a
+/// full or read-only folder leaves no partial file either.
+fn place(staged: &Path, target: &Path) -> Result<()> {
+    let dir = target.parent().ok_or("Invalid content folder")?;
+    let bytes = std::fs::metadata(staged)?.len();
+    if space::available(dir)?.is_some_and(|free| free < bytes.saturating_add(1 << 20)) {
+        return Err("Not enough free space to import this file".into());
+    }
+    let name = target
+        .file_name()
+        .ok_or("Invalid content folder")?
+        .to_string_lossy()
+        .into_owned();
+    let scratch = dir.join(format!(".{name}.importing"));
+    let placed = (|| -> Result<()> {
+        let mut input = std::fs::File::open(staged)?;
+        let mut output = std::fs::OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .open(&scratch)?;
+        content_files::copy_bounded(&mut input, &mut output, |_| {
+            !CANCEL.load(Ordering::Relaxed)
+        })?;
+        output.sync_all()?;
+        drop(output);
+        std::fs::rename(&scratch, target)?;
+        Ok(())
+    })();
+    if placed.is_err() {
+        let _ = std::fs::remove_file(&scratch);
+    }
+    placed
+}
+
+/// Free space left, so a copy that cannot fit is refused before it starts.
+mod space {
+    use super::*;
+
+    #[cfg(target_os = "android")]
+    pub fn available(dir: &Path) -> Result<Option<u64>> {
+        let Ok(c) = std::ffi::CString::new(dir.as_os_str().as_encoded_bytes()) else {
+            return Ok(None);
+        };
+        let mut stats = std::mem::MaybeUninit::<libc::statvfs>::uninit();
+        // SAFETY: `c` is NUL-terminated and `stats` points at writable storage of the
+        // right type; libc::statvfs fills it only on success.
+        let ok = unsafe { libc::statvfs(c.as_ptr(), stats.as_mut_ptr()) } == 0;
+        if !ok {
+            // Unreadable: let the copy try rather than refuse for a reason we cannot state.
+            return Ok(None);
+        }
+        // SAFETY: the call succeeded, so libc initialised every field.
+        let stats = unsafe { stats.assume_init() };
+        let block = stats.f_frsize.max(1);
+        Ok(Some(stats.f_bavail.saturating_mul(block)))
+    }
+
+    #[cfg(not(target_os = "android"))]
+    pub fn available(_dir: &Path) -> Result<Option<u64>> {
+        Ok(None)
+    }
+}
